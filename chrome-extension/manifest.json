{
  "manifest_version": 3,
  "name": "TradeFlow Cookie Capture",
  "version": "1.0.0",
  "description": "Captura cookies de sites para importação de produtos via TradeFlow.",
  "permissions": ["cookies", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TradeFlow Cookie Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
