# Email (Brevo)
BREVO_API_KEY=
ADMIN_EMAIL=
LOJA_NOME=Real Stiles
LOJA_URL=https://realstiles.co.mz

# Endereços FROM por tipo (domínio realstiles.co.mz verificado no Resend)
